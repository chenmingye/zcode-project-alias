{
  "name": "zcode-project-alias-dev",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check plugins/zcode-project-alias/src/server.mjs && node --check plugins/zcode-project-alias/src/store.mjs && node --check plugins/zcode-project-alias/src/panel.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:panel": "node scripts/test-panel.mjs",
    "screenshots": "node scripts/test-panel.mjs --screenshots",
    "package": "python3 scripts/package.py"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "zod": "4.6.7"
  }
}
